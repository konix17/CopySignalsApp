# Copy Signals settings on the server. deploy/setup.sh copies this to .env; replace <your-machine> with the
# address `sudo tailscale serve status` shows, e.g. copy-signals.tail1234.ts.net. Then: sudo systemctl restart copy-signals

# Host names the app answers to: the Tailscale address (and localhost for checks on the server itself).
ALLOWED_HOSTS=localhost,127.0.0.1,<your-machine>.ts.net

# Tailscale serves the app over HTTPS: secure cookies and HSTS on.
HTTPS=1

# Optional: security alerts for admins (each user sets their own phone alerts in Settings).
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-secret-topic
