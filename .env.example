# Copy this file to `.env` and fill in your values. `.env` is never committed.

# OKX, read-only: Profile -> API -> Create API key (European accounts: my.okx.com).
# Choose a passphrase and tick ONLY "Read". The app refuses keys that allow withdrawals.
OKX_API_KEY=
OKX_API_SECRET=
OKX_API_PASSPHRASE=
# OKX_REGION=eea   # eea (default: accounts opened in Europe) or global

# Optional: phone alerts via the ntfy app (https://ntfy.sh). Use a hard-to-guess topic.
# NOTIFY_WEBHOOK_URL=https://ntfy.sh/your-secret-topic

# Optional tuning (defaults shown)
# DEFAULT_BANKROLL=1000
# MAX_PICKS=5
# FEE_RATE=0.001
